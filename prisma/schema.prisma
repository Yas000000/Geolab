// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// When a client's scheduled runs happen (src/lib/due-clients.ts). WEEKLY and
// MONTHLY count days from the last scheduled run (every 7 / every 30);
// FIRST_OF_MONTH is the calendar: the 1st of each month (UTC), added 2026-11-23.
enum RunSchedule {
  MANUAL
  NIGHTLY
  WEEKLY
  MONTHLY
  FIRST_OF_MONTH
}

model Client {
  id        String      @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // schedule drives the recurring GEO-check cadence (src/lib/scheduled-run.ts).
  // ga4PropertyId/gscSiteUrl identify which property/site the daily
  // cron/analytics-pull route pulls real GA4/GSC data for.
  schedule      RunSchedule @default(MANUAL)
  ga4PropertyId String?
  gscSiteUrl    String?

  // Set only by the cron/queue-triggered scheduled-run path (src/lib/scheduled-run.ts),
  // never by a manual on-demand run -- keeps "is this client due for its
  // recurring cadence" independent of ad hoc activity.
  lastScheduledRunAt DateTime?

  // Set when the client is archived (src/lib/client-lifecycle.ts): hidden
  // from the client list, and skipped by every cron job and paid action
  // until restored. All its data is kept.
  archivedAt DateTime?

  brands                Brand[]
  promptSets              PromptSet[]
  runs                    Run[]
  analyticsSnapshots      AnalyticsSnapshot[]
  searchConsoleSnapshots  SearchConsoleSnapshot[]
  aiTrafficSnapshots      AiTrafficSnapshot[]
  countryTrafficSnapshots CountryTrafficSnapshot[]
  benchmarkSnapshots      BenchmarkSnapshot[]
  crawlChecks             CrawlCheck[]
  monthlyReports          MonthlyReport[]
  outreachPlans           OutreachPlan[]
  outreachSites           OutreachSite[]
  login                   User?
  locations               ClientLocation[]

  // Scheduled runs (schedule above) are Training Search unless this is set:
  // multi-location clients get monthly Live Searches instead, since only
  // Live Search can ask as if from a location (user, 2026-11-18).
  scheduledLiveSearch Boolean @default(false)

  // Settings switch for the GEO Traffic tab's AI Conversions section (key events from AI
  // traffic). Off by default; the figures are pulled for every client either way, so
  // switching it on shows history straight away (user, 2026-11-23).
  showAiConversions Boolean @default(false)

  // Other names AI answers use for the client besides its brand name, typed in
  // Settings or Add Client (e.g. "Alaco" for Alaco Ladder). Each counts as a mention
  // exactly like the full name; passed to the pipeline's parser with the bare domain
  // (src/lib/client-names.ts). Separate from BrandAlias, which the competitor-name
  // merge fills in automatically (user, 2026-11-25).
  otherNames String[] @default([])
}

// A place a client is tracked in (MacuMira: Canada, Australia, New Zealand).
// Live Search asks each prompt once per location it's tracked in
// (Prompt.locationIds), as if searching from there; each answer records its
// location (RawResponse.locationId). Training Search ignores locations:
// models answering from memory don't know where the searcher is.
model ClientLocation {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String   // shown everywhere, and the place name the engines are told to search for: "Canada", "Vancouver, Canada"
  country   String   // ISO 3166-1 alpha-2, for the engines' location settings: "CA"
  region    String?  // optional, e.g. "British Columbia"
  city      String?  // optional, e.g. "Vancouver"
  position  Int      // display order
  createdAt DateTime @default(now())

  rawResponses RawResponse[]

  @@unique([clientId, label])
  @@index([clientId])
}

// --- Logins (src/lib/auth.ts, src/proxy.ts) ---------------------------------
// TEAM logins see and do everything. A CLIENT login is the one shared login a
// client gets: it sees only that client's tabs listed in allowedTabs, never
// Settings, and can't trigger anything.

enum UserRole {
  TEAM
  CLIENT
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // stored lowercased
  name               String?
  role               UserRole
  passwordHash       String
  // A generated password must be replaced at the next sign-in (team logins).
  mustChangePassword Boolean   @default(false)
  // CLIENT logins only: the client it belongs to (one login per client) and
  // the tab segments it may open (see CLIENT_TABS in src/lib/auth.ts).
  clientId           String?   @unique
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  allowedTabs        String[]  @default([])
  disabledAt         DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions Session[]
}

model Session {
  // sha256 of the random token in the browser's cookie; the token itself is never stored.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OutreachStatus {
  RUNNING
  COMPLETE
  FAILED
}

// One Outreach Plan build (Outreach Plan tab, src/lib/outreach.ts): built from one Live
// Search crawl, only when someone clicks Build or Rebuild -- it costs real money (site
// research with web search), so nothing builds one on a schedule. plan is the finished
// plan exactly as the tab renders it (python_pipeline/outreach.py build_plan), plus the
// estimate and placed-list caches the next build reuses. progress is set while RUNNING.
model OutreachPlan {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runId       String
  status      OutreachStatus @default(RUNNING)
  progress    Json?
  plan        Json?
  costUsd     Float          @default(0)
  error       String?        @db.Text
  triggeredBy String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  @@index([clientId, createdAt])
}

// A cited site's outreach research for one client (who runs it, every route onto it,
// fees with sources), kept across builds so a rebuild only pays for sites it hasn't
// researched. Saved as each site finishes, so an interrupted build resumes for free.
// research.listing_basis is the set of listed pages the research was told about.
model OutreachSite {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain       String
  research     Json
  model        String
  costUsd      Float    @default(0)
  researchedAt DateTime @default(now())

  @@unique([clientId, domain])
}

// A generated monthly client report (src/lib/monthly-report.ts): one calendar
// month vs the month before, built from this portal's own data. Stored as a
// snapshot -- data is the computed numbers, takeaways the AI-written Key
// Takeaway per section -- so reopening or printing it never changes it or
// costs another API call. Generating the same month again replaces it.
model MonthlyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart  String // "YYYY-MM-DD", first UTC day reported
  periodEnd    String // "YYYY-MM-DD", last UTC day reported (inclusive)
  compareLabel String @default("") // what it was compared with, for the Saved Reports list
  // Which answers it covers: "" = all (every location, each in its own chapter, for a
  // client with locations), a ClientLocation id = that location only, "none" = answers
  // searched with no location.
  location     String @default("")
  data         Json
  takeaways    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One saved report per period and location: regenerating replaces it and keeps its link.
  @@unique([clientId, periodStart, periodEnd, location])
}

// One AI crawler access check of a client's site (python_pipeline/crawlability.py):
// can Claude, Gemini and ChatGPT's own infrastructure reach it? results is the
// per-vendor list exactly as the Python function returns it:
// [{ vendor, tier, confidence, success, detail }]. Run from Settings, and monthly
// by cron/nightly for clients on a non-MANUAL schedule.
model CrawlCheck {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url         String
  triggeredBy String?
  checkedAt   DateTime @default(now())
  results     Json

  @@index([clientId, checkedAt])
}

// A historical benchmark imported from an external document (an ISA/strategy
// report PDF run before this portal tracked the client) -- deliberately
// separate from Run/RawResponse/ParsedResult/Mention rather than forced
// through that pipeline. Those model real individual prompt-check events;
// an ISA's numbers are already pre-aggregated percentages from whatever tool
// produced the report, and reproducing those exact percentages through the
// appearances/totalResponses math would mean fabricating synthetic check
// rows, corrupting "how many real checks happened" for the sake of a single
// historical reference point. The Rankings page renders this as a clearly-
// labeled baseline/reference, not as additional real run data.
model BenchmarkSnapshot {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source           String   // e.g. "ISA" -- room for other historical-import sources later
  snapshotDate     DateTime
  ownVisibilityPct Float?
  ownPosition      Float?
  ownSentiment     Float?   // 0-100, as the source document reports it (e.g. 78.2)
  // #1 Rankings and Top-3 Visibility, when the source document states them
  // (MacuMira's: 24 answers at #1, 33.3%). Left null when it doesn't (Yellowbrick's
  // ISA), and reports then work them out from the prompt table instead
  // (benchmarkPromptFigures in src/lib/monthly-report.ts).
  ownRank1Count    Int?     // answers where the client ranked #1
  ownTop3Pct       Float?   // % of all its answers where the client ranked in the top 3
  // % of its answers citing the client's own site (or a subdomain), when the source
  // has the data (MacuMira's: 33.3%, from its keyword.com export). Null: the report
  // counts it as 0 there (zeroFillBenchmark).
  ownSiteCitedPct  Float?
  sourceNote       String?  // e.g. the source PDF's filename/path, for traceability
  createdAt        DateTime @default(now())

  competitors BenchmarkCompetitor[]
  prompts     BenchmarkPromptResult[]

  @@index([clientId])
}

// One row per competitor brand in a BenchmarkSnapshot's comparison table.
// rawLabel (not a Brand relation) because these come from a document, not a
// detected/resolved mention -- no alias-merge guarantees apply here.
model BenchmarkCompetitor {
  id              String            @id @default(cuid())
  snapshotId      String
  snapshot        BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  name            String
  position        Float?
  visibilityPct   Float?
  sentiment       Int?
  shareOfVoicePct Float?

  @@index([snapshotId])
}

// One row per prompt in a BenchmarkSnapshot's per-prompt benchmark table.
// promptText (not a Prompt relation) -- the source document's prompt list
// doesn't necessarily match any PromptSet ever run through this portal.
// A prompt genuinely absent from the source document's benchmark table
// (vs. present but unranked) simply has no row here at all.
model BenchmarkPromptResult {
  id            String            @id @default(cuid())
  snapshotId    String
  snapshot      BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  promptText    String
  // The AI platform this row is for, when the source breaks its prompt table
  // down by platform (MacuMira's keyword.com benchmark: one row per prompt per
  // engine, so each platform is compared with its own figures). Null: one
  // combined row per prompt (Yellowbrick's ISA).
  platform      Platform?
  position      Float?
  sentiment     Int?
  visibilityPct Float?
  // Other brands that answer named, for the Rankings tab's rule that an answer
  // leaving the client out counts as one place below the last brand it names.
  // Per-platform rows only.
  brandsNamed   Int?
  // When this row was measured, if not on the snapshot's date: a platform's
  // benchmark can come from a later source (MacuMira's Claude rows are from
  // its October 2026 report, Oct 19; its other platforms from Jun 1).
  measuredOn    DateTime?

  @@index([snapshotId])
}

// Singleton row (fixed id "default") -- one Google account's OAuth
// connection covers every client, since it's granted Viewer-or-better
// access to each client's GA4/GSC property directly in Google, not
// something this app grants per client. lastError/lastVerifiedAt drive
// the /settings connection-status UI -- Testing-mode refresh tokens
// expire roughly every 7 days (see src/lib/google-oauth.ts), so this
// needs to surface staleness visibly rather than fail silently.
model GoogleOAuthConnection {
  id             String    @id @default("default")
  connectedEmail String
  refreshToken   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastVerifiedAt DateTime?
  lastError      String?
}

// One row per client per day -- idempotent re-pulls overwrite via the
// unique constraint rather than accumulating duplicates.
model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime
  sessions   Int?
  activeUsers Int?
  keyEvents  Int?
  createdAt  DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

model SearchConsoleSnapshot {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  clicks      Int?
  impressions Int?
  ctr         Float?
  avgPosition Float?
  createdAt   DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// One row per client per day, same idempotent-upsert shape as AnalyticsSnapshot.
// Only AI Assistant is a directly-measured whole bucket; Referral/Unassigned
// totals are stored for context but their *Ai subfields are the real signal
// (a drill-down match against known AI platform names, not the whole bucket --
// see src/lib/ai-traffic.ts). directSessions has no AI-share detection signal
// at all (no referrer) -- any AI-share estimate for it is applied at render
// time from an external benchmark figure, deliberately not stored here.
model AiTrafficSnapshot {
  id                    String   @id @default(cuid())
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date                  DateTime
  directSessions        Int?
  aiAssistantSessions   Int?
  referralSessions      Int?
  referralAiSessions    Int?
  unassignedSessions    Int?
  unassignedAiSessions  Int?
  // AI Conversions (2026-11-23, src/lib/ai-traffic.ts). Null = not pulled yet for that day.
  // Key events (GA4's conversions) and engaged sessions in the visits counted above, the
  // whole site's totals for the averages, key events by people whose first visit came from
  // an AI platform (whenever they converted), and the in-visit key events by event name.
  aiAssistantKeyEvents        Int?
  referralAiKeyEvents         Int?
  unassignedAiKeyEvents       Int?
  aiAssistantEngagedSessions  Int?
  referralAiEngagedSessions   Int?
  unassignedAiEngagedSessions Int?
  siteSessions                Int?
  siteKeyEvents               Int?
  siteEngagedSessions         Int?
  aiIntroducedKeyEvents       Int?
  aiKeyEventsByName           Json? // { "contact_us_form_submit_patient": 1 }; null when none
  // Direct's own key events, engaged sessions and first-visit (introduced) key events, for
  // the Direct AI estimate (DIRECT_AI_SHARE_ESTIMATE) the user had folded into AI
  // Conversions (2026-11-23). Raw Direct figures; the estimate is applied at render time.
  directKeyEvents             Int?
  directEngagedSessions       Int?
  directIntroducedKeyEvents   Int?
  createdAt             DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// The same daily GA4 figures (AnalyticsSnapshot + AiTrafficSnapshot) for one
// country, pulled only for the countries of a client's locations (MacuMira:
// CA, AU, NZ) -- the Traffic tab and reports show each location's own
// traffic from these. `country` is GA4's countryId (ISO 3166-1 alpha-2, same
// as ClientLocation.country). A day with no visits from that country has no row.
model CountryTrafficSnapshot {
  id                    String   @id @default(cuid())
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date                  DateTime
  country               String
  sessions              Int?
  activeUsers           Int?
  keyEvents             Int?
  directSessions        Int?
  aiAssistantSessions   Int?
  referralSessions      Int?
  referralAiSessions    Int?
  unassignedSessions    Int?
  unassignedAiSessions  Int?
  createdAt             DateTime @default(now())

  @@unique([clientId, date, country])
  @@index([clientId, country])
}

// A brand tracked for a client -- either the client's own brand
// (isClientBrand = true) or a competitor surfaced via --auto-competitors.
model Brand {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  domain        String?
  isClientBrand Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases  BrandAlias[]
  mentions Mention[]

  @@unique([clientId, name])
  @@index([clientId])
}

// Alternate observed name strings that resolve to the same canonical Brand
// -- e.g. "HiBar Maintain" / "Kitsch Color" as sub-product-line names of
// "HiBAR" / "Kitsch". Persists the alias-merge problem solved per-run via
// _merge_substring_aliases() in geo-proposal-generator at the schema level.
model BrandAlias {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  alias   String

  @@unique([brandId, alias])
  @@index([alias])
}

model PromptSet {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())

  prompts Prompt[]
  runs    Run[]

  @@index([clientId])
}

model Prompt {
  id          String    @id @default(cuid())
  promptSetId String
  promptSet   PromptSet @relation(fields: [promptSetId], references: [id], onDelete: Cascade)
  category    String?
  text        String
  position    Int
  // The client's locations (ClientLocation ids) this prompt is tracked in.
  // Empty: asked once with no location, as before locations existed.
  locationIds String[]  @default([])

  rawResponses RawResponse[]

  @@index([promptSetId])
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model Run {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  promptSetId String
  promptSet   PromptSet @relation(fields: [promptSetId], references: [id])
  status      RunStatus @default(PENDING)
  triggeredBy String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  rawResponses RawResponse[]

  @@index([clientId])
  @@index([promptSetId])
}

enum Platform {
  CLAUDE
  CHATGPT
  GEMINI
  PERPLEXITY
}

model RawResponse {
  id           String    @id @default(cuid())
  runId        String
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptId     String
  prompt       Prompt    @relation(fields: [promptId], references: [id])
  platform     Platform
  modelId      String?
  responseText String    @db.Text
  createdAt    DateTime  @default(now())
  // Where the answer was searched from (Live Search with locations); null =
  // no location, every answer before locations existed.
  locationId   String?
  location     ClientLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  parsedResult ParsedResult?
  citations    Citation[]

  // One answer per prompt, platform and location in a run. Postgres treats
  // NULLs as distinct, so rows with no location rely on the run writing each
  // (prompt, platform) once, as it always has.
  @@unique([runId, promptId, platform, locationId])
  @@index([runId])
  @@index([locationId])
}

// A page an AI answer cited -- Live Search responses only (Training Search
// has no web access). position is the order it was first cited in that
// answer; url is de-duplicated within one response. domain is stored (host
// without "www.") so the Citations page can group by site without parsing
// URLs at read time; for an unresolved Gemini redirect it is the site
// Gemini named rather than the redirect host.
model Citation {
  id            String      @id @default(cuid())
  rawResponseId String
  rawResponse   RawResponse @relation(fields: [rawResponseId], references: [id], onDelete: Cascade)
  position      Int
  url           String      @db.Text
  title         String?     @db.Text
  domain        String
  // The parts of the answer this page backs, as [[start, end], ...] offsets
  // into RawResponse.responseText in UTF-16 code units (JavaScript string
  // indexes), sorted. From the platform's own per-claim citation data:
  // Claude and Gemini mark the cited claim, ChatGPT marks the inline link it
  // puts inside the sentence. Null for Perplexity (it gives none) and for
  // runs crawled before 2026-11-12.
  spans         Json?

  @@index([rawResponseId])
  @@index([domain])
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model ParsedResult {
  id                   String      @id @default(cuid())
  rawResponseId        String      @unique
  rawResponse          RawResponse @relation(fields: [rawResponseId], references: [id], onDelete: Cascade)
  clientBrandMentioned Boolean
  clientBrandRank      Int?
  sentiment            Sentiment?
  excerpt              String?     @db.Text
  createdAt            DateTime    @default(now())

  mentions Mention[]
}

// One row per brand (client's own or a competitor) found in a single
// parsed response -- rawLabel keeps the exact as-seen text pre-alias
// resolution; brandId is null until that text has been matched to a
// canonical Brand.
model Mention {
  id             String       @id @default(cuid())
  parsedResultId String
  parsedResult   ParsedResult @relation(fields: [parsedResultId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  rawLabel       String
  position       Int?
  sentiment      Sentiment?

  @@index([parsedResultId])
  @@index([brandId])
}
