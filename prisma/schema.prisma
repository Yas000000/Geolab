// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunSchedule {
  MANUAL
  NIGHTLY
  WEEKLY
  MONTHLY
}

model Client {
  id        String      @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // schedule drives the recurring GEO-check cadence (src/lib/scheduled-run.ts).
  // ga4PropertyId/gscSiteUrl identify which property/site the daily
  // cron/analytics-pull route pulls real GA4/GSC data for.
  schedule      RunSchedule @default(MANUAL)
  ga4PropertyId String?
  gscSiteUrl    String?

  // Set only by the cron/queue-triggered scheduled-run path (src/lib/scheduled-run.ts),
  // never by a manual on-demand run -- keeps "is this client due for its
  // recurring cadence" independent of ad hoc activity.
  lastScheduledRunAt DateTime?

  brands                  Brand[]
  promptSets              PromptSet[]
  runs                    Run[]
  analyticsSnapshots      AnalyticsSnapshot[]
  searchConsoleSnapshots  SearchConsoleSnapshot[]
  aiTrafficSnapshots      AiTrafficSnapshot[]
  benchmarkSnapshots      BenchmarkSnapshot[]
}

// A historical benchmark imported from an external document (an ISA/strategy
// report PDF run before this portal tracked the client) -- deliberately
// separate from Run/RawResponse/ParsedResult/Mention rather than forced
// through that pipeline. Those model real individual prompt-check events;
// an ISA's numbers are already pre-aggregated percentages from whatever tool
// produced the report, and reproducing those exact percentages through the
// appearances/totalResponses math would mean fabricating synthetic check
// rows, corrupting "how many real checks happened" for the sake of a single
// historical reference point. The Rankings page renders this as a clearly-
// labeled baseline/reference, not as additional real run data.
model BenchmarkSnapshot {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source           String   // e.g. "ISA" -- room for other historical-import sources later
  snapshotDate     DateTime
  ownVisibilityPct Float?
  ownPosition      Float?
  ownSentiment     Int?     // 0-100, as the source document reports it
  sourceNote       String?  // e.g. the source PDF's filename/path, for traceability
  createdAt        DateTime @default(now())

  competitors BenchmarkCompetitor[]
  prompts     BenchmarkPromptResult[]

  @@index([clientId])
}

// One row per competitor brand in a BenchmarkSnapshot's comparison table.
// rawLabel (not a Brand relation) because these come from a document, not a
// detected/resolved mention -- no alias-merge guarantees apply here.
model BenchmarkCompetitor {
  id              String            @id @default(cuid())
  snapshotId      String
  snapshot        BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  name            String
  position        Float?
  visibilityPct   Float?
  sentiment       Int?
  shareOfVoicePct Float?

  @@index([snapshotId])
}

// One row per prompt in a BenchmarkSnapshot's per-prompt benchmark table.
// promptText (not a Prompt relation) -- the source document's prompt list
// doesn't necessarily match any PromptSet ever run through this portal.
// A prompt genuinely absent from the source document's benchmark table
// (vs. present but unranked) simply has no row here at all.
model BenchmarkPromptResult {
  id            String            @id @default(cuid())
  snapshotId    String
  snapshot      BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  promptText    String
  position      Float?
  sentiment     Int?
  visibilityPct Float?

  @@index([snapshotId])
}

// Singleton row (fixed id "default") -- one Google account's OAuth
// connection covers every client, since it's granted Viewer-or-better
// access to each client's GA4/GSC property directly in Google, not
// something this app grants per client. lastError/lastVerifiedAt drive
// the /settings connection-status UI -- Testing-mode refresh tokens
// expire roughly every 7 days (see src/lib/google-oauth.ts), so this
// needs to surface staleness visibly rather than fail silently.
model GoogleOAuthConnection {
  id             String    @id @default("default")
  connectedEmail String
  refreshToken   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastVerifiedAt DateTime?
  lastError      String?
}

// One row per client per day -- idempotent re-pulls overwrite via the
// unique constraint rather than accumulating duplicates.
model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime
  sessions   Int?
  activeUsers Int?
  keyEvents  Int?
  createdAt  DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

model SearchConsoleSnapshot {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  clicks      Int?
  impressions Int?
  ctr         Float?
  avgPosition Float?
  createdAt   DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// One row per client per day, same idempotent-upsert shape as AnalyticsSnapshot.
// Only AI Assistant is a directly-measured whole bucket; Referral/Unassigned
// totals are stored for context but their *Ai subfields are the real signal
// (a drill-down match against known AI platform names, not the whole bucket --
// see src/lib/ai-traffic.ts). directSessions has no AI-share detection signal
// at all (no referrer) -- any AI-share estimate for it is applied at render
// time from an external benchmark figure, deliberately not stored here.
model AiTrafficSnapshot {
  id                    String   @id @default(cuid())
  clientId              String
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date                  DateTime
  directSessions        Int?
  aiAssistantSessions   Int?
  referralSessions      Int?
  referralAiSessions    Int?
  unassignedSessions    Int?
  unassignedAiSessions  Int?
  createdAt             DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// A brand tracked for a client -- either the client's own brand
// (isClientBrand = true) or a competitor surfaced via --auto-competitors.
model Brand {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  domain        String?
  isClientBrand Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases  BrandAlias[]
  mentions Mention[]

  @@unique([clientId, name])
  @@index([clientId])
}

// Alternate observed name strings that resolve to the same canonical Brand
// -- e.g. "HiBar Maintain" / "Kitsch Color" as sub-product-line names of
// "HiBAR" / "Kitsch". Persists the alias-merge problem solved per-run via
// _merge_substring_aliases() in geo-proposal-generator at the schema level.
model BrandAlias {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  alias   String

  @@unique([brandId, alias])
  @@index([alias])
}

model PromptSet {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())

  prompts Prompt[]
  runs    Run[]

  @@index([clientId])
}

model Prompt {
  id          String    @id @default(cuid())
  promptSetId String
  promptSet   PromptSet @relation(fields: [promptSetId], references: [id], onDelete: Cascade)
  category    String?
  text        String
  position    Int

  rawResponses RawResponse[]

  @@index([promptSetId])
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model Run {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  promptSetId String
  promptSet   PromptSet @relation(fields: [promptSetId], references: [id])
  status      RunStatus @default(PENDING)
  triggeredBy String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  rawResponses RawResponse[]

  @@index([clientId])
  @@index([promptSetId])
}

enum Platform {
  CLAUDE
  CHATGPT
  GEMINI
  PERPLEXITY
}

model RawResponse {
  id           String    @id @default(cuid())
  runId        String
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  promptId     String
  prompt       Prompt    @relation(fields: [promptId], references: [id])
  platform     Platform
  modelId      String?
  responseText String    @db.Text
  createdAt    DateTime  @default(now())

  parsedResult ParsedResult?

  @@unique([runId, promptId, platform])
  @@index([runId])
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model ParsedResult {
  id                   String      @id @default(cuid())
  rawResponseId        String      @unique
  rawResponse          RawResponse @relation(fields: [rawResponseId], references: [id], onDelete: Cascade)
  clientBrandMentioned Boolean
  clientBrandRank      Int?
  sentiment            Sentiment?
  excerpt              String?     @db.Text
  createdAt            DateTime    @default(now())

  mentions Mention[]
}

// One row per brand (client's own or a competitor) found in a single
// parsed response -- rawLabel keeps the exact as-seen text pre-alias
// resolution; brandId is null until that text has been matched to a
// canonical Brand.
model Mention {
  id             String       @id @default(cuid())
  parsedResultId String
  parsedResult   ParsedResult @relation(fields: [parsedResultId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  rawLabel       String
  position       Int?
  sentiment      Sentiment?

  @@index([parsedResultId])
  @@index([brandId])
}
